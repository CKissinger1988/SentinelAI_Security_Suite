rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidEncryptedRecord(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.encryptedData is string && data.encryptedData.size() <= 1000000 &&
             data.iv is string && data.iv.size() <= 64 &&
             data.createdAt is string;
    }

    match /encrypted_records/{recordId} {
      allow create: if isSignedIn() && isValidId(recordId) && isValidEncryptedRecord(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
