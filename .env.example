# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HSM_MASTER_KEY: 64-character hex string (32 bytes) for the hardware security module simulation.
HSM_MASTER_KEY="your_64_character_hex_string_here"

# JWT_SECRET: Strong secret for JWT token generation. Use HS512 minimum length.
JWT_SECRET="your_very_long_and_secure_jwt_secret_here"

# MASTER_ADMIN_HASH: SHA-512 hash of the Creator/APEX tier password.
MASTER_ADMIN_HASH="your_sha512_password_hash_here"

# Networking & CORS
PORT=3001
CORS_ORIGINS="http://localhost:3001"
SPARTANAI_SECURITY_CORE_HTTPS="false"
